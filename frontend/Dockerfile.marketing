FROM node:20 AS build

ARG REACT_APP_API_URL=/api/v1
ARG REACT_APP_SUPABASE_URL=
ARG REACT_APP_SUPABASE_ANON_KEY=
ARG REACT_APP_URL=https://buildomain.com

ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_SUPABASE_URL=$REACT_APP_SUPABASE_URL
ENV REACT_APP_SUPABASE_ANON_KEY=$REACT_APP_SUPABASE_ANON_KEY
ENV REACT_APP_URL=$REACT_APP_URL
ENV NG_CLI_ANALYTICS=false
ENV NODE_OPTIONS="--max-old-space-size=1536"

WORKDIR /app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

COPY . .

RUN npm run build -- --configuration production > /tmp/build.log 2>&1 || { cat /tmp/build.log; exit 1; }
RUN ls -la /app/dist/angular-version/browser

FROM nginx:alpine

ARG REACT_APP_API_URL=/api/v1
ARG REACT_APP_SUPABASE_URL=
ARG REACT_APP_SUPABASE_ANON_KEY=
ARG REACT_APP_URL=https://buildomain.com

ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_SUPABASE_URL=$REACT_APP_SUPABASE_URL
ENV REACT_APP_SUPABASE_ANON_KEY=$REACT_APP_SUPABASE_ANON_KEY
ENV REACT_APP_URL=$REACT_APP_URL

RUN apk add --no-cache curl gettext

COPY --from=build /app/dist/angular-version/browser /usr/share/nginx/html
COPY src/assets/env.template.js /tmp/env.template.js
COPY nginx.marketing.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /usr/share/nginx/html/assets \
  && envsubst < /tmp/env.template.js > /usr/share/nginx/html/assets/env.js

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
