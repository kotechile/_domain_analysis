FROM node:20 AS build

ENV NG_CLI_ANALYTICS=false
ENV NODE_OPTIONS="--max-old-space-size=1536"

WORKDIR /app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

COPY . .

RUN npm run build -- --configuration production > /tmp/build.log 2>&1 || { cat /tmp/build.log; exit 1; }
RUN ls -la /app/dist/angular-version/browser

FROM nginx:alpine

RUN apk add --no-cache curl

COPY --from=build /app/dist/angular-version/browser /usr/share/nginx/html
COPY nginx.marketing.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
